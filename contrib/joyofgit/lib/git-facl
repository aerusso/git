import os, sys, functools, itertools
import argparse, subprocess, re
from pathlib import Path
from collections import defaultdict
toplevel = subprocess.run(['git', 'rev-parse', '--show-toplevel'], check=True, capture_output=True).stdout[:-1].decode('utf8')

def get_files(ns):
    #sub = subprocess.run(['git', 'sparse-checkout', 'list'], check=True, capture_output)
    #regexps = []

    #for l in sub.stdout.split(b'\n'):
    #    if not l:
    #        continue

    #    regexps.append(re.compile(l[:-1].decode('ascii')))

    # TODO: update .facl based on the files added/removed/whatever
    sub = subprocess.Popen(['git', 'status', '--porcelain', '-z'], stdout=subprocess.PIPE, cwd=toplevel)
    reader = iter(functools.partial(sub.stdout.read, 1), b'')
    files = defaultdict(list)
    while True:
        line = b''.join(itertools.takewhile(b'\0'.__ne__, reader))
        if not line:
            break

        line = line.decode('utf-8')
        files[line[3:]].append(line[:2])
    balance, _ = sub.communicate()
    assert not balance
    assert not sub.returncode

    sub = subprocess.Popen(['git', 'ls-files', '--full-name', '-zv'], stdout=subprocess.PIPE, cwd=toplevel)
    reader = iter(functools.partial(sub.stdout.read, 1), b'')
    do_files = []
    directories = set()
    sparse = None
    while True:
        line = b''.join(itertools.takewhile(b'\0'.__ne__, reader))
        if not line:
            break

        line = line.decode('utf-8')
        mod, filename = line.split(' ')
        status = files.get(filename, ('  ',))
        if filename == ns.facl_file:
            if mod == 'S':
                sparse = True
            else:
                sparse = False
            continue
        elif mod == 'S':
            continue
        elif (status[0][0] == 'D') or (status[0][1] == 'D'):
            continue
        # check other things?

        f = Path(filename).parent
        do_files.append(filename)

        while True:
            f_str = str(f)
            if f_str in directories:
                break
            directories.add(f_str)
            do_files.append(f_str)
            f = f.parent

    balance, _ = sub.communicate()
    assert not balance
    assert not sub.returncode
    return sorted(do_files), sparse

